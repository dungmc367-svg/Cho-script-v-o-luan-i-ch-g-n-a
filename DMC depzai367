-- ========================================================
-- LOGIC TÍNH NĂNG TỐI ƯU CHO EVADE
-- ========================================================

-- 1. XỬ LÝ TĂNG TỐC (CFrame Velocity Boost - Bypass Evade Anti-Speed)
RunService.RenderStepped:Connect(function(deltaTime)
    if SpeedEnabled and LocalPlayer.Character then
        local char = LocalPlayer.Character
        local root = getPrimaryPart(char)
        local hum = char:FindFirstChildOfClass("Humanoid")

        if root and hum and hum.MoveDirection.Magnitude > 0 then
            local extraSpeed = math.max(0, TargetSpeed - 16)
            if extraSpeed > 0 then
                -- Dịch chuyển CFrame mượt mà theo hướng di chuyển của nhân vật
                root.CFrame = root.CFrame + (hum.MoveDirection * (extraSpeed * deltaTime))
            end
        end
    end
end)

-- 2. XỬ LÝ INFINITE JUMP
UserInputService.JumpRequest:Connect(function()
    if InfiniteJumpEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

-- 3. XỬ LÝ BHOP
RunService.RenderStepped:Connect(function()
    if BhopEnabled and UserInputService:IsKeyDown(Enum.KeyCode.Space) and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.FloorMaterial ~= Enum.Material.Air then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

