-- CÁC HÀM TẠO ESP XUYÊN TƯỜNG & HITBOX
-- ========================================================

local function createNameTag(parentPart, nameText, color)
    local bbg = Instance.new("BillboardGui")
    bbg.Name = "NameTag"
    bbg.Adornee = parentPart
    bbg.Size = UDim2.new(0, 160, 0, 30)
    bbg.StudsOffset = Vector3.new(0, 3.5, 0)
    bbg.AlwaysOnTop = true

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Text = nameText
    txt.TextColor3 = color
    txt.TextSize = 14
    txt.Font = Enum.Font.SourceSansBold
    txt.TextStrokeTransparency = 0
    txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    txt.Parent = bbg

    return bbg
end

local function createHitboxBox(part, color)
    local box = Instance.new("BoxHandleAdornment")
    box.Name = "HitboxBox"
    box.Adornee = part
    box.Size = part.Size + Vector3.new(0.2, 0.2, 0.2)
    box.Color3 = color
    box.Transparency = 0.4
    box.AlwaysOnTop = true
    box.ZIndex = 10
    return box
end

-- Tìm danh sách Nextbots (Quét sâu cấu trúc thư mục của Evade)
local function getEvadeNextbots()
    local nextbots = {}
    local gameFolder = workspace:FindFirstChild("Game")

    if gameFolder then
        -- 1. Thư mục Game.Bots
        local botFolder = gameFolder:FindFirstChild("Bots")
        if botFolder then
            for _, bot in pairs(botFolder:GetChildren()) do
                if bot:IsA("Model") then
                    table.insert(nextbots, bot)
                end
            end
        end

        -- 2. Thư mục Game.Players (Chứa NPC/Nextbot không thuộc Players Service)
        local gamePlayers = gameFolder:FindFirstChild("Players")
        if gamePlayers then
            for _, obj in pairs(gamePlayers:GetChildren()) do
                if obj:IsA("Model") and not Players:GetPlayerFromCharacter(obj) then
                    table.insert(nextbots, obj)
                end
            end
        end
    end

    -- 3. Thư mục Workspace gốc (Dự phòng)
    for _, obj in pairs(workspace:GetChildren()) do
        if obj:IsA("Model") and not Players:GetPlayerFromCharacter(obj) and obj ~= LocalPlayer.Character then
            if (obj:FindFirstChild("HRP") or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildOfClass("Humanoid")) 
               and obj.Name ~= "Game" and obj.Name ~= "Map" then
                if not table.find(nextbots, obj) then
                    table.insert(nextbots, obj)
                end
            end
        end
    end

    return nextbots
end

-- Vòng lặp cập nhật ESP định kỳ
RunService.RenderStepped:Connect(function()
    -- Dọn dẹp ESP cũ khi đối tượng đã biến mất / chết
    for _, espGroup in pairs(ESPFolder:GetChildren()) do
        local tag = espGroup:FindFirstChild("NameTag")
        if tag and (not tag.Adornee or not tag.Adornee.Parent) then
            espGroup:Destroy()
        end
    end

    -- --- 1. ESP NGƯỜI CHƠI (Màu Xanh Lá) ---
    if PlayerESPEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = player.Character or (workspace:FindFirstChild("Game") and workspace.Game:FindFirstChild("Players") and workspace.Game.Players:FindFirstChild(player.Name))
                if char then
                    local root = getPrimaryPart(char)
                    local folderName = "P_" .. player.Name

                    if root and not ESPFolder:FindFirstChild(folderName) then
                        local espGroup = Instance.new("Folder")
                        espGroup.Name = folderName
                        espGroup:SetAttribute("ESPType", "Player")

                        -- Highlight xuyên tường
                        local hl = Instance.new("Highlight")
                        hl.Adornee = char
                        hl.FillColor = Color3.fromRGB(0, 255, 100)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.FillTransparency = 0.5
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = espGroup

                        -- Hitbox Khung Xanh Lá
                        local hitbox = createHitboxBox(root, Color3.fromRGB(0, 255, 100))
                        hitbox.Parent = espGroup

                        -- Tên Người Chơi
                        local nameTag = createNameTag(root, "[Player] " .. player.Name, Color3.fromRGB(0, 255, 100))
                        nameTag.Parent = espGroup

                        espGroup.Parent = ESPFolder
                    end
                end
            end
        end
    end

    -- --- 2. ESP NEXTBOT / QUÁI EVADE (Màu Đỏ) ---
    if NextbotESPEnabled then
        local nextbots = getEvadeNextbots()
        for _, bot in pairs(nextbots) do
            local root = getPrimaryPart(bot)
            local folderName = "N_" .. bot.Name .. "_" .. tostring(bot:GetDebugId())

            if root and not ESPFolder:FindFirstChild(folderName) then
                local espGroup = Instance.new("Folder")
                espGroup.Name = folderName
                espGroup:SetAttribute("ESPType", "Nextbot")

                -- Highlight Đỏ xuyên tường
                local hl = Instance.new("Highlight")
                hl.Adornee = bot
                hl.FillColor = Color3.fromRGB(255, 30, 30)
                hl.OutlineColor = Color3.fromRGB(255, 255, 0)
                hl.FillTransparency = 0.3
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = espGroup

                -- Hitbox Khung Đỏ
                local hitbox = createHitboxBox(root, Color3.fromRGB(255, 0, 0))
                hitbox.Parent = espGroup

                -- Tên Nextbot
                local nameTag = createNameTag(root, "⚠️ [NEXTBOT] " .. bot.Name, Color3.fromRGB(255, 50, 50))
                nameTag.Parent = espGroup

                espGroup.Parent = ESPFolder
            end
        end
    end
end)
